PORT=3000
MONGODB_URI=mongodb://localhost:27018/boekmap
# Key voor de Cultuurconnect Catalogus API, aan te vragen via https://www.cultuurconnect.be/diensten/apis
CATALOGUS_KEY=
# Hoe lang de gevonden boeken per locatie bewaard worden voor ze opnieuw opgehaald worden
BOOKS_MAX_AGE_DAYS=365
# Optioneel, wordt meegestuurd naar Nominatim (OpenStreetMap) zoals hun gebruiksvoorwaarden vragen
CONTACT_EMAIL=
